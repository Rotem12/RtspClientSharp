<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RtspClientSharp.WinForms</RootNamespace>
    <AssemblyName>RtspClientSharp.WinForms</AssemblyName>
    <Version>1.3.3</Version>
    <FileAlignment>512</FileAlignment>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'AnyCPU' Or '$(Platform)' == ''">AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RtspClientSharp\RtspClientSharp.csproj" />
  </ItemGroup>

  <Target Name="CopyRtspClientSharpNativeHelper" AfterTargets="Build">
    <PropertyGroup>
      <RtspClientSharpNativePlatform Condition="'$(RtspClientSharpNativePlatform)' == '' And ('$(Platform)' == 'x64' Or '$(PlatformTarget)' == 'x64')">x64</RtspClientSharpNativePlatform>
      <RtspClientSharpNativePlatform Condition="'$(RtspClientSharpNativePlatform)' == ''">x86</RtspClientSharpNativePlatform>
      <RtspClientSharpNativeHelperPath Condition="'$(RtspClientSharpNativeHelperPath)' == ''">$(MSBuildProjectDirectory)\..\Examples\libffmpeghelper\$(RtspClientSharpNativePlatform)\$(Configuration)\libffmpeghelper.dll</RtspClientSharpNativeHelperPath>
    </PropertyGroup>
    <Copy SourceFiles="$(RtspClientSharpNativeHelperPath)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(RtspClientSharpNativeHelperPath)')" />
  </Target>
</Project>
